{
  "name": "set-scan-types-experiment",
  "label": "Set scan types from spreadsheet",
  "description": "Set scan types for an XNAT experiment from a CSV file in a project resource",
  "version": "0.1",
  "schema-version": "1.0",
  "info-url": "",
  "image": "mmilch01/dicom_classifier:0.13",
  "type": "docker",
  "command-line": "set_scan_types_xnat \"#RESOURCE_NAME#\" \"#CSV_NAME#\" -server \"$XNAT_HOST\" -user \"$XNAT_USER\" -pass \"$XNAT_PASS\" -project \"#PROJECT_ID#\" -experiment \"#EXPERIMENT_ID#\" -label-column \"#LABEL_COLUMN#\"",
  "override-entrypoint": true,
  "mounts": [],
  "environment-variables": {},
  "ports": {},
  "inputs": [
    {
      "name": "RESOURCE_NAME",
      "label": "Resource name",
      "description": "Name of the XNAT project resource containing the spreadsheet",
      "type": "string",
      "required": true,
      "replacement-key": "#RESOURCE_NAME#",
      "select-values": []
    },
    {
      "name": "CSV_NAME",
      "label": "Spreadsheet filename",
      "description": "Filename of the CSV spreadsheet within the project resource",
      "type": "string",
      "required": true,
      "replacement-key": "#CSV_NAME#",
      "select-values": []
    },
    {
      "name": "PROJECT_ID",
      "label": "Project ID",
      "description": "XNAT project ID",
      "type": "string",
      "required": true,
      "replacement-key": "#PROJECT_ID#",
      "select-values": []
    },
    {
      "name": "LABEL_COLUMN",
      "label": "Label column",
      "description": "Label column for a type I CSV",
      "type": "string",
      "default-value": "labels1",
      "required": false,
      "replacement-key": "#LABEL_COLUMN#",
      "select-values": []
    },
    {
      "name": "EXPERIMENT_ID",
      "label": "Experiment ID",
      "description": "XNAT experiment/session ID",
      "type": "string",
      "required": true,
      "replacement-key": "#EXPERIMENT_ID#",
      "select-values": []
    }
  ],
  "outputs": [],
  "xnat": [
    {
      "name": "set-scan-types-from-spreadsheet-experiment",
      "label": "Set scan types from spreadsheet",
      "description": "Set scan types for this experiment from a CSV file in a project resource",
      "contexts": [
        "xnat:imageSessionData"
      ],
      "external-inputs": [
        {
          "name": "session",
          "description": "Input session",
          "type": "Session",
          "required": true,
          "load-children": false
        },
        {
          "name": "resource-name",
          "label": "Resource name",
          "description": "Name of the project resource containing the spreadsheet",
          "type": "string",
          "required": true,
          "provides-value-for-command-input": "RESOURCE_NAME",
          "load-children": true
        },
        {
          "name": "csv-name",
          "label": "Spreadsheet filename",
          "description": "Filename of the CSV spreadsheet within the project resource",
          "type": "string",
          "required": true,
          "provides-value-for-command-input": "CSV_NAME",
          "load-children": true
        },
        {
          "name": "label-column",
          "label": "Label column",
          "description": "Label column for a type I CSV",
          "type": "string",
          "default-value": "labels1",
          "required": false,
          "provides-value-for-command-input": "LABEL_COLUMN",
          "load-children": true
        }
      ],
      "derived-inputs": [
        {
          "name": "project-id",
          "description": "XNAT project ID",
          "type": "string",
          "required": true,
          "provides-value-for-command-input": "PROJECT_ID",
          "load-children": true,
          "derived-from-wrapper-input": "session",
          "derived-from-xnat-object-property": "project-id",
          "multiple": false
        },
        {
          "name": "experiment-label",
          "description": "XNAT experiment label",
          "type": "string",
          "required": true,
          "provides-value-for-command-input": "EXPERIMENT_ID",
          "load-children": true,
          "derived-from-wrapper-input": "session",
          "derived-from-xnat-object-property": "label",
          "multiple": false
        }
      ],
      "output-handlers": []
    }
  ],
  "reserve-memory": 2048,
  "container-labels": {},
  "generic-resources": {},
  "ulimits": {},
  "secrets": [],
  "visibility": "public"
}
