#!/bin/bash

xnat_get_jsession() {
    local server=$1
    local user=$2
    local password=$3
    local jsession

    jsession=$(curl -s -k -u "$user:$password" \
        "$server/data/JSESSION") || return 1

    [ -n "$jsession" ] || return 1
    [[ "$jsession" != *Error* ]] || return 1
    printf '%s\n' "$jsession"
}

xnat_download_project_resource_file() {
    local server=$1
    local project_id=$2
    local resource_name=$3
    local remote_filename=$4
    local destination=$5
    local jsession=$6
    local url

    url="$server/data/projects/$project_id/resources/$resource_name/files/$remote_filename"
    curl -k --cookie "JSESSIONID=$jsession" -o "$destination" "$url" 
    
    [ -f "$destination" ]
}

xnat_upload_project_resource_file() {
    local server=$1
    local project_id=$2
    local resource_name=$3
    local local_file=$4
    local remote_filename=$5
    local jsession=$6
    local url

    url="$server/data/projects/$project_id/resources/$resource_name/files/$remote_filename?overwrite=true"

    curl -k --cookie "JSESSIONID=$jsession" \
        -X PUT \
        -F "file=@$local_file" \
        "$url"
}
