#!/bin/bash

xnat_get_jsession() {
    local server="$1" user="$2" password="$3" jsession curl_status

    jsession=$(curl -s -k --fail -u "$user:$password" "$server/data/JSESSION")
    curl_status=$?
    echo -n "$jsession"
    return "$curl_status"
}

xnat_close_jsession() {
    local server="$1" jsession="$2"

    curl -s -k --fail \
        --cookie "JSESSIONID=$jsession" \
        --request DELETE \
        "$server/data/JSESSION/"
}

xnat_download_project_resource_file() {
    local server="$1" project_id="$2" resource_name="$3" 
    local remote_filename="$4" destination="$5" jsession="$6" url cmd
    url="$server/data/projects/$project_id/resources/$resource_name/files/$remote_filename"

    printf 'JSESSION: %q, length=%d\n' "$jsession" "${#jsession}"

    cmd=(curl --fail -k --cookie "JSESSIONID=$jsession" --output "$destination" "$url")
    echo ${cmd[@]}
    "${cmd[@]}"
}

xnat_upload_project_resource_file() {
    local server=$1 project_id=$2 resource_name=$3 local_file=$4
    local remote_filename=$5 jsession=$6 url cmd
    url="$server/data/projects/$project_id/resources/$resource_name/files/$remote_filename?overwrite=true"

    cmd=(curl --fail --show-error -k --cookie "JSESSIONID=$jsession" --request PUT --form "file=@$local_file" "$url")
    echo ${cmd[@]}
    "${cmd[@]}"
}
