#!/bin/bash

handle_error() {
    local program_name="$1"
    local message="$2"

    echo "$program_name ERROR: $message"
    exit 1
}

handle_warning() {
    local program_name="$1"
    local message="$2"

    echo "$program_name WARNING: $message"
}

ensure_directory() {
    local directory="$1"

    [ -d "$directory" ] || mkdir -p "$directory"
}
